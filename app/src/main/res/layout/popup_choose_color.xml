<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_gray"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:text="@string/color"
        android:textColor="@color/black"
        android:textSize="25sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/item_0"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_0" />

        <ImageView
            android:id="@+id/item_1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_1" />

        <ImageView
            android:id="@+id/item_2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_2" />

        <ImageView
            android:id="@+id/item_3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_3" />

        <ImageView
            android:id="@+id/item_4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_4" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/item_5"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_5" />

        <ImageView
            android:id="@+id/item_6"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_6" />

        <ImageView
            android:id="@+id/item_7"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_7" />

        <ImageView
            android:id="@+id/item_8"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_8" />

        <ImageView
            android:id="@+id/item_9"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_btn_choose"
            android:padding="8dp"
            android:src="@drawable/ic_color_select_9" />

    </LinearLayout>

</LinearLayout>