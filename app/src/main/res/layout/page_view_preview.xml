<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/layout_nativeads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="10dp">

        <com.google.android.ads.nativetemplates.TemplateView
            android:id="@+id/app_nativeads_ngan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:gnt_size_min="true"
            app:gnt_template_type="@layout/gnt_medium_template_view" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layout_middle_group"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_above="@+id/layout_nativeads"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/preview_ic_dot"
            android:layout_width="70dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_dot_preview_1" />

        <TextView
            android:id="@+id/preview_btn_next"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_app"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/onboarding_continue"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <ImageView
        android:id="@+id/img_preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_middle_group"
        android:scaleType="centerCrop" />

    <com.google.android.ads.nativetemplates.TemplateView
        android:id="@+id/app_nativeads_full"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        app:gnt_template_type="@layout/gnt_full_template_view" />

</RelativeLayout>